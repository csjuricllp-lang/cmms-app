  UserOrganization UserOrganization @relation(fields: [userId], references: [id], onDelete: Cascade)
  WorkOrder        WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@id([workOrderId, userId])
}

model WorkOrderTimeLog {
  id               String           @id
  workOrderId      String
  userId           String
  category         String?
  hoursLogged      Decimal
  hourlyRate       Decimal
  totalCost        Decimal
  startTime        DateTime?
  endTime          DateTime?
  description      String?
  createdAt        DateTime         @default(now())
  UserOrganization UserOrganization @relation(fields: [userId], references: [id])
  WorkOrder        WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

model WorkflowRule {
  id             String       @id
  name           String
  description    String?
  entity         String
  trigger        String
  conditions     Json
  actions        Json
  isActive       Boolean      @default(true)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, entity, trigger])
}

