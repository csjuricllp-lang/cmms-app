generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiKey {
  id             String       @id
  name           String
  key            String       @unique
  prefix         String
  scopes         String[]
  organizationId String
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  Organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model ApprovalChain {
  id             String         @id
  name           String
  description    String?
  entityType     String         @default("WORK_ORDER")
  minCost        Decimal?       @default(0)
  organizationId String
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  Organization   Organization   @relation(fields: [organizationId], references: [id])
  ApprovalStep   ApprovalStep[]
}

model ApprovalRecord {
  id               String            @id
  workOrderId      String
  userId           String?
  status           ApprovalStatus    @default(PENDING)
  notes            String?
  stepOrder        Int               @default(0)
  organizationId   String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  UserOrganization UserOrganization? @relation(fields: [userId], references: [id])
  WorkOrder        WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

model ApprovalStep {
  id              String        @id
  approvalChainId String
  roleId          String
  order           Int           @default(0)
  ApprovalChain   ApprovalChain @relation(fields: [approvalChainId], references: [id], onDelete: Cascade)
  Role            Role          @relation(fields: [roleId], references: [id])
}

model Asset {
  id                   String               @id
  name                 String
  description          String?
  status               AssetStatus          @default(OPERATIONAL)
  version              Int                  @default(1)
  updatedByDeviceId    String?
  criticality          Criticality          @default(MEDIUM)
  brand                String?
  model                String?
  serialNumber         String?
  qrCode               String?              @unique
  barCode              String?              @unique
  category             String?
  categoryId           String?
  purchasePrice        Decimal?
  purchaseDate         DateTime?
  warrantyExpiry       DateTime?
  downtimeStartedAt    DateTime?
  totalDowntimeMinutes Int                  @default(0)
  parentAssetId        String?
  assignedToId         String?
  replacementCost      Decimal?
  expectedLifeYears    Int?
  annualBudget         Decimal?             @default(0)
  specifications       Json?
  tags                 String[]
  notes                String?
  locationId           String
  vendorId             String?
  customerId           String?
  organizationId       String
  isMobile             Boolean              @default(false)
  requiresLOTO         Boolean              @default(false)
  lockoutProcedure     String?
  residualValue        Decimal?
  depreciationMethod   String?              @default("STRAIGHT_LINE")
  usefulLifeYears      Int?                 @default(10)
  placedInServiceDate  DateTime?
  teamId               String?
  additionalWorkerIds  String[]
  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime
  imageUrl             String?
  UserOrganization     UserOrganization?    @relation(fields: [assignedToId], references: [id])
  Category             Category?            @relation(fields: [categoryId], references: [id])
  Customer             Customer?            @relation(fields: [customerId], references: [id])
  Location             Location             @relation(fields: [locationId], references: [id])
  Organization         Organization         @relation(fields: [organizationId], references: [id])
  Asset                Asset?               @relation("AssetToAsset", fields: [parentAssetId], references: [id])
  other_Asset          Asset[]              @relation("AssetToAsset")
  Team                 Team?                @relation(fields: [teamId], references: [id])
  Vendor               Vendor?              @relation(fields: [vendorId], references: [id])
  AssetFile            AssetFile[]
  AssetPart            AssetPart[]
  AssetStatusHistory   AssetStatusHistory[]
  MaintenanceRequest   MaintenanceRequest[]
  Meter                Meter[]
  PMSchedule           PMSchedule[]
  Permit               Permit[]
  WorkOrder            WorkOrder[]

  @@index([organizationId, categoryId])
  @@index([organizationId, createdAt])
  @@index([organizationId, deletedAt])
  @@index([organizationId])
  @@index([organizationId, locationId])
}

model AssetField {
  id             String       @id
  label          String
  type           String
  options        String[]     @default([])
  precision      Int?
  isSystem       Boolean      @default(false)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  entityType     String       @default("ASSET")
  Organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([label, entityType, organizationId])
}

model AssetFile {
  id           String   @id
  assetId      String
  filename     String
  url          String
  mimeType     String?
  size         Int?
  uploadedById String
  version      Int      @default(1)
  parentId     String?
  annotations  Json?
  scanMetadata Json?
  createdAt    DateTime @default(now())
  Asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

model AssetPart {
  id              String         @id
  assetId         String
  partId          String
  inventoryLineId String?
  organizationId  String
  quantityNeeded  Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  Asset           Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  InventoryLine   InventoryLine? @relation(fields: [inventoryLineId], references: [id])
  Organization    Organization   @relation(fields: [organizationId], references: [id])
  Part            Part           @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([assetId, partId])
}

model AssetSchedule {
  id             String       @id
  name           String
  config         Json
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([name, organizationId])
}

model AssetStatusHistory {
  id          String       @id
  assetId     String
  fromStatus  AssetStatus?
  toStatus    AssetStatus
  changedById String
  reason      String?
  createdAt   DateTime     @default(now())
  Asset       Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

model AssetTemplate {
  id             String       @id
  name           String
  description    String?
  category       String?
  criticality    Criticality  @default(MEDIUM)
  specifications Json?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Organization   Organization @relation(fields: [organizationId], references: [id])
}

model AuditLog {
  id             String       @id
  action         String
  model          String
  entityId       String
  userId         String?
  organizationId String
  oldData        Json?
  newData        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  Organization   Organization @relation(fields: [organizationId], references: [id])
  User           User?        @relation(fields: [userId], references: [id])
}

model Category {
  id             String       @id
  name           String
  color          String       @default("#2196F3")
  type           CategoryType
  isSystem       Boolean      @default(false)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Asset          Asset[]
  Organization   Organization @relation(fields: [organizationId], references: [id])
  Meter          Meter[]
  PMSchedule     PMSchedule[]
  Part           Part[]
  WorkOrder      WorkOrder[]

  @@unique([name, organizationId, type])
}

model ChangeLog {
  id             String       @id
  entityType     String
  entityId       String
  operation      String
  version        Int
  changedFields  String[]
  organizationId String
  changedAt      DateTime     @default(now())
  Organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([entityType, entityId])
  @@index([organizationId, changedAt])
}

model Checklist {
  id                 String               @id
  title              String
  description        String?
  isSystem           Boolean              @default(false)
  organizationId     String
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  Organization       Organization         @relation(fields: [organizationId], references: [id])
  ChecklistItem      ChecklistItem[]
  PMSchedule         PMSchedule[]
  PMScheduleTemplate PMScheduleTemplate[]
  WorkOrder          WorkOrder[]
}

model ChecklistItem {
  id                         String                       @id
  checklistId                String
  task                       String
  dataType                   ChecklistItemType            @default(CHECKBOX)
  options                    String[]
  isRequired                 Boolean                      @default(true)
  failTriggerWO              Boolean                      @default(false)
  order                      Int                          @default(0)
  instruction                String?
  instructionPhotos          String[]
  instructionUrl             String?
  instructionUrlTitle        String?
  requireNotes               Boolean                      @default(false)
  requirePhoto               Boolean                      @default(false)
  requireUrl                 Boolean                      @default(false)
  Checklist                  Checklist                    @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  WorkOrderChecklistResponse WorkOrderChecklistResponse[]
}

model CustomStatus {
  id             String          @id
  label          String
  color          String          @default("#2196F3")
  systemStatus   WorkOrderStatus
  isSystem       Boolean         @default(false)
  organizationId String
  Organization   Organization    @relation(fields: [organizationId], references: [id])
  WorkOrder      WorkOrder[]

  @@unique([label, organizationId])
}

model Customer {
  id             String       @id
  name           String
  email          String?
  phone          String?
  address        String?
  website        String?
  type           String?
  description    String?
  hourlyRate     Float?
  isVip          Boolean      @default(false)
  billingName    String?
  billingAddress String?
  addressLine2   String?
  addressLine3   String?
  currency       String?      @default("USD")
  organizationId String
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  customFields   Json?
  Asset          Asset[]
  Organization   Organization @relation(fields: [organizationId], references: [id])
  Part           Part[]
  Location       Location[]   @relation("LocationCustomers")
}

model Document {
  id               String           @id
  filename         String
  url              String
  mimeType         String?
  size             Int?
  tags             String[]         @default([])
  uploadedById     String
  organizationId   String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  Organization     Organization     @relation(fields: [organizationId], references: [id])
  UserOrganization UserOrganization @relation(fields: [uploadedById], references: [id])

  @@index([organizationId])
}

model FailureCode {
  id             String       @id
  code           String
  name           String
  description    String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Organization   Organization @relation(fields: [organizationId], references: [id])
  WorkOrder      WorkOrder[]

  @@unique([code, organizationId])
}

model FeatureFlag {
  id             String       @id
  organizationId String
  key            String
  enabled        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

model InventoryLine {
  id             String          @id
  partId         String
  locationId     String?
  area           String?
  availableQty   Int             @default(0)
  minQty         Int             @default(0)
  maxQty         Int?
  barcode        String?
  cost           Decimal?
  organizationId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  AssetPart      AssetPart[]
  Location       Location?       @relation(fields: [locationId], references: [id])
  Organization   Organization    @relation(fields: [organizationId], references: [id])
  Part           Part            @relation(fields: [partId], references: [id], onDelete: Cascade)
  WorkOrderPart  WorkOrderPart[]
}

model InventoryTransaction {
  id               String                   @id
  partId           String
  quantity         Int
  type             InventoryTransactionType
  referenceId      String?
  userId           String
  organizationId   String
  createdAt        DateTime                 @default(now())
  Organization     Organization             @relation(fields: [organizationId], references: [id])
  Part             Part                     @relation(fields: [partId], references: [id], onDelete: Cascade)
  UserOrganization UserOrganization         @relation(fields: [userId], references: [id])
}

model Invitation {
  id             String       @id
  email          String
  roleId         String
  organizationId String
  token          String       @unique
  expiresAt      DateTime
  invitedById    String
  teamIds        String[]
  hourlyRate     Decimal?
  skills         String[]
  locationIds    String[]
  createdAt      DateTime     @default(now())
  companyRate    Decimal?
  jobTitle       String?
  name           String?
  phone          String?
  User           User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id])
  Role           Role         @relation(fields: [roleId], references: [id])

  @@index([email])
}

model Location {
  id                 String               @id
  name               String
  description        String?
  address            String?
  type               LocationType         @default(SITE)
  parentId           String?
  organizationId     String
  latitude           Float?
  longitude          Float?
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  imageUrl           String?
  timezone           String?              @default("Asia/Kolkata")
  priority           String?
  status             String               @default("Active")
  Asset              Asset[]
  InventoryLine      InventoryLine[]
  Organization       Organization         @relation(fields: [organizationId], references: [id])
  Location           Location?            @relation("LocationToLocation", fields: [parentId], references: [id])
  other_Location     Location[]           @relation("LocationToLocation")
  LocationFile       LocationFile[]
  MaintenanceRequest MaintenanceRequest[]
  Meter              Meter[]
  Part               Part[]
  Permit             Permit[]
  WorkOrder          WorkOrder[]
  Customer           Customer[]           @relation("LocationCustomers")
  Team               Team[]               @relation("LocationTeams")
  Vendor             Vendor[]             @relation("LocationVendors")
  UserOrganization   UserOrganization[]   @relation("LocationWorkers")
}

model LocationFile {
  id           String   @id
  locationId   String
  filename     String
  url          String
  mimeType     String?
  size         Int?
  uploadedById String
  createdAt    DateTime @default(now())
  Location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

model MaintenanceRequest {
  id               String            @id
  title            String
  description      String?
  imageUrl         String?
  status           RequestStatus     @default(PENDING)
  locationId       String?
  assetId          String?
  workOrderId      String?           @unique
  requesterId      String?
  guestName        String?
  guestEmail       String?
  guestPhone       String?
  organizationId   String
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  priority         Priority          @default(NONE)
  Asset            Asset?            @relation(fields: [assetId], references: [id])
  Location         Location?         @relation(fields: [locationId], references: [id])
  Organization     Organization      @relation(fields: [organizationId], references: [id])
  UserOrganization UserOrganization? @relation(fields: [requesterId], references: [id])
  WorkOrder        WorkOrder?        @relation(fields: [workOrderId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId])
  @@index([organizationId, status])
}

model Meter {
  id               String            @id
  name             String
  unit             String
  assetId          String
  currentValue     Decimal?          @default(0)
  threshold        Decimal?
  triggerPM        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  assignedToId     String?
  categoryId       String?
  frequency        Int?              @default(1)
  imageUrl         String?
  locationId       String?
  organizationId   String?
  deletedAt        DateTime?
  Asset            Asset             @relation(fields: [assetId], references: [id])
  UserOrganization UserOrganization? @relation(fields: [assignedToId], references: [id])
  Category         Category?         @relation(fields: [categoryId], references: [id])
  Location         Location?         @relation(fields: [locationId], references: [id])
  Organization     Organization?     @relation(fields: [organizationId], references: [id])
  MeterReading     MeterReading[]
  PMSchedule       PMSchedule[]
}

model MeterReading {
  id           String   @id
  value        Decimal
  meterId      String
  recordedById String?
  notes        String?
  createdAt    DateTime @default(now())
  Meter        Meter    @relation(fields: [meterId], references: [id])
}

model Notification {
  id             String       @id
  type           String
  title          String
  content        String
  userId         String?
  isRead         Boolean      @default(false)
  metaData       Json?
  organizationId String
  createdAt      DateTime     @default(now())
  Organization   Organization @relation(fields: [organizationId], references: [id])
}

model NotificationTemplate {
  id             String       @id
  slug           String       @unique
  name           String
  subject        String?
  body           String
  active         Boolean      @default(true)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Organization   Organization @relation(fields: [organizationId], references: [id])
}

model Organization {
  id                   String                 @id
  name                 String
  plan                 String                 @default("FREE")
  featureFlags         Json?
  businessHours        Json?
  subscriptionEndsAt   DateTime?
  teamSize             String?
  deletedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  ApiKey               ApiKey[]
  ApprovalChain        ApprovalChain[]
  Asset                Asset[]
  AssetField           AssetField[]
  AssetPart            AssetPart[]
  AssetSchedule        AssetSchedule[]
  AssetTemplate        AssetTemplate[]
  AuditLog             AuditLog[]
  Category             Category[]
  ChangeLog            ChangeLog[]
  Checklist            Checklist[]
  CustomStatus         CustomStatus[]
  Customer             Customer[]
  Document             Document[]
  FailureCode          FailureCode[]
  FeatureFlag          FeatureFlag[]
  InventoryLine        InventoryLine[]
  InventoryTransaction InventoryTransaction[]
  Invitation           Invitation[]
  Location             Location[]
  MaintenanceRequest   MaintenanceRequest[]
  Meter                Meter[]
  Notification         Notification[]
  NotificationTemplate NotificationTemplate[]
  PMSchedule           PMSchedule[]
  PMScheduleTemplate   PMScheduleTemplate[]
  Part                 Part[]
  PartTemplate         PartTemplate[]
  Permit               Permit[]
  PurchaseOrder        PurchaseOrder[]
  PushSubscription     PushSubscription[]
  Role                 Role[]
  SavedView            SavedView[]
  ScheduledReport      ScheduledReport[]
  Setting              Setting[]
  Shift                Shift[]
  SsoConfig            SsoConfig?
  SyncConflict         SyncConflict[]
  SyncQueue            SyncQueue[]
  SyncState            SyncState[]
  Tag                  Tag[]
  Team                 Team[]
  UserOrganization     UserOrganization[]
  Vendor               Vendor[]
  WebhookSubscription  WebhookSubscription[]
  WorkOrder            WorkOrder[]
  WorkflowRule         WorkflowRule[]
}

model PMSchedule {
  id                       String                     @id
  name                     String
  description              String?
  woTitle                  String?
  woDescription            String?
  imageUrl                 String?
  isActive                 Boolean                    @default(true)
  advanceNoticeDays        Int                        @default(7)
  assetId                  String
  checklistId              String?
  assignedToId             String?
  categoryId               String?
  priority                 Priority                   @default(MEDIUM)
  organizationId           String
  deletedAt                DateTime?
  frequencyType            FrequencyType?
  frequencyValue           Int?
  isFloating               Boolean                    @default(false)
  lastGenerated            DateTime?
  nextDueDate              DateTime?
  meterId                  String?
  meterInterval            Decimal?
  lastMeterReading         Decimal?
  nextMeterReading         Decimal?
  status                   PMScheduleStatus           @default(ACTIVE)
  version                  Int                        @default(1)
  isSeasonal               Boolean                    @default(false)
  startMonth               Int?
  endMonth                 Int?
  overdueCount             Int                        @default(0)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime
  durationHours            Decimal?
  requiresSignature        Boolean                    @default(false)
  dueDateTime              String?
  createWOType             String?                    @default("AHEAD")
  meterWODueValue          Int?
  meterWODueUnit           String?
  meterTriggerType         String                     @default("INTERVAL")
  Asset                    Asset                      @relation(fields: [assetId], references: [id])
  UserOrganization         UserOrganization?          @relation(fields: [assignedToId], references: [id])
  Category                 Category?                  @relation(fields: [categoryId], references: [id])
  Checklist                Checklist?                 @relation(fields: [checklistId], references: [id])
  Meter                    Meter?                     @relation(fields: [meterId], references: [id])
  Organization             Organization               @relation(fields: [organizationId], references: [id])
  PMScheduleFile           PMScheduleFile[]
  PMScheduleInactivePeriod PMScheduleInactivePeriod[]
  PMSchedulePlannedPart    PMSchedulePlannedPart[]
  PMScheduleTask           PMScheduleTask[]
  WorkOrder                WorkOrder[]
}

model PMScheduleFile {
  id               String           @id
  pmScheduleId     String
  filename         String
  url              String
  mimeType         String
  size             Int
  uploadedById     String
  createdAt        DateTime         @default(now())
  PMSchedule       PMSchedule       @relation(fields: [pmScheduleId], references: [id], onDelete: Cascade)
  UserOrganization UserOrganization @relation(fields: [uploadedById], references: [id])
}

model PMScheduleInactivePeriod {
  id           String     @id
  pmScheduleId String
  startDate    DateTime
  endDate      DateTime
  reason       String?
  createdAt    DateTime   @default(now())
  PMSchedule   PMSchedule @relation(fields: [pmScheduleId], references: [id], onDelete: Cascade)
}

model PMSchedulePlannedPart {
  id             String     @id
  pmScheduleId   String
  partId         String
  quantity       Decimal
  organizationId String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  Part           Part       @relation(fields: [partId], references: [id], onDelete: Cascade)
  PMSchedule     PMSchedule @relation(fields: [pmScheduleId], references: [id], onDelete: Cascade)

  @@unique([pmScheduleId, partId])
}

model PMScheduleTask {
  id             String     @id
  pmScheduleId   String
  task           String
  order          Int        @default(0)
  organizationId String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  PMSchedule     PMSchedule @relation(fields: [pmScheduleId], references: [id], onDelete: Cascade)
}

model PMScheduleTemplate {
  id             String        @id
  name           String
  description    String?
  frequencyType  FrequencyType
  frequencyValue Int
  checklistId    String?
  version        Int           @default(1)
  isSystem       Boolean       @default(false)
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  Checklist      Checklist?    @relation(fields: [checklistId], references: [id])
  Organization   Organization  @relation(fields: [organizationId], references: [id])
}

model Part {
  id                    String                  @id
  name                  String
  description           String?
  partNumber            String?
  barcode               String?                 @unique
  category              String?
  tags                  String?
  manufacturer          String?
  quantity              Int                     @default(0)
  minQuantity           Int                     @default(0)
  maxQuantity           Int?
  allocatedQuantity     Int                     @default(0)
  cost                  Decimal?
  criticality           Criticality             @default(MEDIUM)
  status                PartStatus              @default(ACTIVE)
  assignedToId          String?
  locationId            String?
  binLocation           String?
  vendorId              String?
  teamId                String?
  customerId            String?
  organizationId        String
  deletedAt             DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  categoryId            String?
  autoReorderEnabled    Boolean                 @default(false)
  AssetPart             AssetPart[]
  InventoryLine         InventoryLine[]
  InventoryTransaction  InventoryTransaction[]
  PMSchedulePlannedPart PMSchedulePlannedPart[]
  UserOrganization      UserOrganization?       @relation(fields: [assignedToId], references: [id])
  Category              Category?               @relation(fields: [categoryId], references: [id])
  Customer              Customer?               @relation(fields: [customerId], references: [id])
  Location              Location?               @relation(fields: [locationId], references: [id])
  Organization          Organization            @relation(fields: [organizationId], references: [id])
  Team                  Team?                   @relation(fields: [teamId], references: [id])
  Vendor                Vendor?                 @relation(fields: [vendorId], references: [id])
  PartFile              PartFile[]
  PurchaseOrderItem     PurchaseOrderItem[]
  WorkOrderPart         WorkOrderPart[]
  WorkOrderPlannedPart  WorkOrderPlannedPart[]
}

model PartFile {
  id           String   @id
  partId       String
  filename     String
  url          String
  mimeType     String?
  size         Int?
  uploadedById String
  createdAt    DateTime @default(now())
  Part         Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
}

model PartTemplate {
  id             String       @id
  name           String
  description    String?
  category       String?
  specifications Json?
  version        Int          @default(1)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Organization   Organization @relation(fields: [organizationId], references: [id])
}

model Permission {
  id          String   @id
  key         String   @unique
  name        String
  description String?
  priority    Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Role        Role[]   @relation("RolePermissions")
}

model Permit {
