generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                    String                 @id @default(uuid())
  name                  String
  plan                  String                 @default("FREE")
  featureFlags          Json?
  businessHours         Json?
  subscriptionEndsAt    DateTime?
  teamSize              String?
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  apiKeys               ApiKey[]
  approvalChains        ApprovalChain[]
  assets                Asset[]
  assetFields           AssetField[]
  assetParts            AssetPart[]
  assetSchedules        AssetSchedule[]
  assetTemplates        AssetTemplate[]
  auditLogs             AuditLog[]
  categories            Category[]
  changeLog             ChangeLog[]
  checklists            Checklist[]
  customStatuses        CustomStatus[]
  customers             Customer[]
  failureCodes          FailureCode[]
  featureFlagsRelation  FeatureFlag[]
  inventoryLines        InventoryLine[]
  inventoryTransactions InventoryTransaction[]
  invitations           Invitation[]
  locations             Location[]
  maintenanceRequests   MaintenanceRequest[]
  meters                Meter[]
  notifications         Notification[]
  notificationTemplates NotificationTemplate[]
  pmSchedules           PMSchedule[]
  pmTemplates           PMScheduleTemplate[]
  parts                 Part[]
  partTemplates         PartTemplate[]
  purchaseOrders        PurchaseOrder[]
  pushSubscriptions     PushSubscription[]
  roles                 Role[]
  savedViews            SavedView[]
  scheduledReports      ScheduledReport[]
  settings              Setting[]
  shifts                Shift[]
  ssoConfig             SsoConfig?
  syncConflicts         SyncConflict[]
  syncQueue             SyncQueue[]
  syncState             SyncState[]
  tags                  Tag[]
  teams                 Team[]
  members               UserOrganization[]
  vendors               Vendor[]
  webhookSubscriptions  WebhookSubscription[]
  workOrders            WorkOrder[]
  workflowRules         WorkflowRule[]
}

model AuditLog {
  id             String       @id @default(uuid())
  action         String
  model          String
  entityId       String
  userId         String?
  organizationId String
  oldData        Json?
  newData        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User?        @relation(fields: [userId], references: [id])
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  password           String?
  firstName          String?
  lastName           String?
  name               String
  phone              String?
  jobTitle           String?
  department         String?
  avatarUrl          String?
  ssoProvider        String?
  ssoId              String?            @unique
  isActive           Boolean            @default(true)
  invitationToken    String?            @unique
  lastLoginAt        DateTime?
  lastLoginIp        String?
  lastActiveAt       DateTime?          @default(now())
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deactivatedAt      DateTime?
  deactivatedById    String?
  deactivationReason String?
  auditLogs          AuditLog[]
  invitationsIssued  Invitation[]
  refreshTokens      RefreshToken[]
  organizations      UserOrganization[]
}

model Role {
  id                String             @id @default(uuid())
  name              String
  description       String?
  externalId        String?
  isSystem          Boolean            @default(false)
  organizationId    String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  approvalSteps     ApprovalStep[]
  invitations       Invitation[]
  organization      Organization       @relation(fields: [organizationId], references: [id])
  userOrganizations UserOrganization[] @relation("RoleMembership")
  permissions       Permission[]       @relation("RolePermissions")

  @@unique([name, organizationId])
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  priority    Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       Role[]   @relation("RolePermissions")
}

model UserOrganization {
  id                      String                       @id @default(uuid())
  userId                  String
  organizationId          String
  roleId                  String?
  hourlyRate              Decimal?
  skills                  String[]
  customPermissions       String[]                     @default([])
  subscriptionEndsAt      DateTime?
  notificationSettings    Json?
  assignedLocationIds     String[]
  shiftId                 String?
  companyRate             Decimal?
  approvals               ApprovalRecord[]
  custodianOf             Asset[]                      @relation("AssetCustodian")
  inventoryTransactions   InventoryTransaction[]       @relation("InventoryTransactionUser")
  requests                MaintenanceRequest[]         @relation("UserRequests")
  assignedMeters          Meter[]                      @relation("AssignedMeters")
  pmSchedules             PMSchedule[]                 @relation("AssignedPMSchedules")
  uploadedPMScheduleFiles PMScheduleFile[]
  managedParts            Part[]                       @relation("PartManager")
  organization            Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role                    Role?                        @relation("RoleMembership", fields: [roleId], references: [id])
  shift                   Shift?                       @relation(fields: [shiftId], references: [id])
  user                    User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  teams                   UsersOnTeams[]
  workOrders              WorkOrder[]                  @relation("AssignedWorkOrders")
  closedWorkOrders        WorkOrder[]                  @relation("WorkOrderClosedBy")
  signedWorkOrders        WorkOrder[]                  @relation("WorkOrderSignature")
  checklistResponses      WorkOrderChecklistResponse[] @relation("WorkOrderChecklistResponder")
  workOrderComments       WorkOrderComment[]           @relation("WorkOrderComments")
  expenses                WorkOrderExpense[]           @relation("WorkOrderExpenses")
  lotoLocked              WorkOrderLOTO[]              @relation("WorkOrderLOTOLock")
  lotoUnlocked            WorkOrderLOTO[]              @relation("WorkOrderLOTOUnlock")
  partsAssigned           WorkOrderPart[]              @relation("WorkOrderPartAssignedBy")
  technicianOf            WorkOrderTechnician[]        @relation("AssignedWorkOrderTechnicians")
  timeLogs                WorkOrderTimeLog[]           @relation("WorkOrderTimeLogs")
  locationRefs            Location[]                   @relation("LocationWorkers")

  @@unique([userId, organizationId])
}

model Team {
  id             String         @id @default(uuid())
  name           String
  description    String?
  organizationId String
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  isActive       Boolean        @default(true)
  assets         Asset[]
  parts          Part[]
  organization   Organization   @relation(fields: [organizationId], references: [id])
  users          UsersOnTeams[]
  workOrders     WorkOrder[]
  locations      Location[]     @relation("LocationTeams")
}

model Shift {
  id             String             @id @default(uuid())
  name           String
  startTime      String
  endTime        String
  workDays       Int[]
  organizationId String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id])
  users          UserOrganization[]
}

model UsersOnTeams {
  userOrgId String
  teamId    String
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userOrg   UserOrganization @relation(fields: [userOrgId], references: [id], onDelete: Cascade)

  @@id([userOrgId, teamId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  id             String               @id @default(uuid())
  name           String
  description    String?
  address        String?
  type           LocationType         @default(SITE)
  parentId       String?
  organizationId String
  latitude       Float?
  longitude      Float?
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  imageUrl       String?
  timezone       String?              @default("Asia/Kolkata")
  priority       String?
  status         String               @default("Active")
  assets         Asset[]
  inventoryLines InventoryLine[]
  organization   Organization         @relation(fields: [organizationId], references: [id])
  parent         Location?            @relation("LocationHierarchy", fields: [parentId], references: [id])
  children       Location[]           @relation("LocationHierarchy")
  files          LocationFile[]
  requests       MaintenanceRequest[]
  meters         Meter[]
  parts          Part[]
  workOrders     WorkOrder[]
  customers      Customer[]           @relation("LocationCustomers")
  teams          Team[]               @relation("LocationTeams")
  vendors        Vendor[]             @relation("LocationVendors")
  workers        UserOrganization[]   @relation("LocationWorkers")
}

model LocationFile {
  id           String   @id @default(uuid())
  locationId   String
  filename     String
  url          String
  mimeType     String?
  size         Int?
  uploadedById String
  createdAt    DateTime @default(now())
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

model Asset {
  id                   String               @id @default(uuid())
  name                 String
  description          String?
  status               AssetStatus          @default(OPERATIONAL)
  version              Int                  @default(1)
  updatedByDeviceId    String?
  criticality          Criticality          @default(MEDIUM)
  brand                String?
  model                String?
  serialNumber         String?
  qrCode               String?              @unique
  barCode              String?              @unique
  category             String?
  categoryId           String?
  purchasePrice        Decimal?
  purchaseDate         DateTime?
  warrantyExpiry       DateTime?
  downtimeStartedAt    DateTime?
  totalDowntimeMinutes Int                  @default(0)
  parentAssetId        String?
  assignedToId         String?
  replacementCost      Decimal?
  expectedLifeYears    Int?
  annualBudget         Decimal?             @default(0)
  specifications       Json?
  tags                 String[]
  notes                String?
  locationId           String
  vendorId             String?
  customerId           String?
  organizationId       String
  isMobile             Boolean              @default(false)
  requiresLOTO         Boolean              @default(false)
  lockoutProcedure     String?
  residualValue        Decimal?
  depreciationMethod   String?              @default("STRAIGHT_LINE")
  usefulLifeYears      Int?                 @default(10)
  placedInServiceDate  DateTime?
  teamId               String?
  additionalWorkerIds  String[]
  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  imageUrl             String?
  custodian            UserOrganization?    @relation("AssetCustodian", fields: [assignedToId], references: [id])
  categoryRef          Category?            @relation(fields: [categoryId], references: [id])
  customer             Customer?            @relation(fields: [customerId], references: [id])
  location             Location             @relation(fields: [locationId], references: [id])
  organization         Organization         @relation(fields: [organizationId], references: [id])
  parent               Asset?               @relation("AssetHierarchy", fields: [parentAssetId], references: [id])
  children             Asset[]              @relation("AssetHierarchy")
  team                 Team?                @relation(fields: [teamId], references: [id])
  vendor               Vendor?              @relation(fields: [vendorId], references: [id])
  attachments          AssetFile[]
  spareParts           AssetPart[]
  statusHistory        AssetStatusHistory[]
  requests             MaintenanceRequest[]
  meters               Meter[]
  pmSchedules          PMSchedule[]
  workOrders           WorkOrder[]

  @@index([organizationId])
  @@index([organizationId, categoryId])
  @@index([organizationId, locationId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, createdAt])
}

model AssetPart {
  id              String         @id @default(uuid())
  assetId         String
  partId          String
  inventoryLineId String?
  organizationId  String
  quantityNeeded  Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  asset           Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  inventoryLine   InventoryLine? @relation(fields: [inventoryLineId], references: [id])
  organization    Organization   @relation(fields: [organizationId], references: [id])
  part            Part           @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([assetId, partId])
}

model AssetTemplate {
  id             String       @id @default(uuid())
  name           String
  description    String?
  category       String?
  criticality    Criticality  @default(MEDIUM)
  specifications Json?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
}

/// Tracks every status change on an asset — powers MTTR and reliability reports
model AssetStatusHistory {
  id          String       @id @default(uuid())
  assetId     String
  fromStatus  AssetStatus?
  toStatus    AssetStatus
  changedById String
  reason      String?
  createdAt   DateTime     @default(now())
  asset       Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

/// Links uploaded files to a specific asset
model AssetFile {
  id           String   @id @default(uuid())
  assetId      String
  filename     String
  url          String
  mimeType     String?
  size         Int?
  uploadedById String
  version      Int      @default(1)
  parentId     String?
  annotations  Json?
  scanMetadata Json?
  createdAt    DateTime @default(now())
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

model WorkOrder {
  id                   String                       @id @default(uuid())
  workOrderNo          Int                          @default(autoincrement())
  title                String
  version              Int                          @default(1)
  updatedByDeviceId    String?
  description          String?
  status               WorkOrderStatus              @default(OPEN)
  priority             Priority                     @default(MEDIUM)
  maintenanceType      MaintenanceType              @default(REACTIVE)
  category             String?
  categoryId           String?
  dueDate              DateTime?
  endDueDate           DateTime?
  startDate            DateTime?
  completedAt          DateTime?
  estimatedHours       Decimal?
  actualHours          Decimal?                     @default(0)
  completedOnTime      Boolean?                     @default(true)
  laborCost            Decimal                      @default(0)
  partsCost            Decimal                      @default(0)
  additionalCost       Decimal                      @default(0)
  estimatedCost        Decimal                      @default(0)
  totalCost            Decimal                      @default(0)
  onHoldReason         String?
  resolutionNotes      String?
  signatureUrl         String?
  signedById           String?
  requiresLOTO         Boolean                      @default(false)
  lotoVerified         Boolean                      @default(false)
  isDowntimeEvent      Boolean                      @default(false)
  downtimeMinutes      Int?                         @default(0)
  signatureRequired    Boolean                      @default(false)
  customFields         Json?
  problemCode          String?
  rootCause            String?
  rootCauseDetails     String?
  rootCauseCode        String?
  actionCode           String?
  parentWorkOrderId    String?
  pmScheduleId         String?
  assetId              String?
  locationId           String?
  assignedToId         String?
  assignedTeamId       String?
  vendorId             String?
  invoiceNumber        String?
  checklistId          String?
  predecessorId        String?
  responseTimeTarget   DateTime?
  resolutionTimeTarget DateTime?
  escalatedAt          DateTime?
  isEscalated          Boolean                      @default(false)
  organizationId       String
  deletedAt            DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  shareToken           String?                      @unique
  isShared             Boolean                      @default(false)
  isBookmarked         Boolean                      @default(false)
  isRepeating          Boolean                      @default(false)
  customStatusId       String?
  approvalChainId      String?
  currentApprovalStep  Int                          @default(0)
  failureCodeId        String?
  closedAt             DateTime?
  closedById           String?
  closeoutNotes        String?
  approvals            ApprovalRecord[]
  request              MaintenanceRequest?
  purchaseOrders       PurchaseOrder[]
  asset                Asset?                       @relation(fields: [assetId], references: [id])
  assignedTeam         Team?                        @relation(fields: [assignedTeamId], references: [id])
  assignedTo           UserOrganization?            @relation("AssignedWorkOrders", fields: [assignedToId], references: [id])
  categoryRef          Category?                    @relation(fields: [categoryId], references: [id])
  checklist            Checklist?                   @relation(fields: [checklistId], references: [id])
  closedBy             UserOrganization?            @relation("WorkOrderClosedBy", fields: [closedById], references: [id])
  customStatus         CustomStatus?                @relation(fields: [customStatusId], references: [id])
  failureCode          FailureCode?                 @relation(fields: [failureCodeId], references: [id])
  location             Location?                    @relation(fields: [locationId], references: [id])
  organization         Organization                 @relation(fields: [organizationId], references: [id])
  parentWorkOrder      WorkOrder?                   @relation("WorkOrderHierarchy", fields: [parentWorkOrderId], references: [id])
  childWorkOrders      WorkOrder[]                  @relation("WorkOrderHierarchy")
  pmSchedule           PMSchedule?                  @relation(fields: [pmScheduleId], references: [id])
  predecessor          WorkOrder?                   @relation("WorkOrderDependency", fields: [predecessorId], references: [id])
  successors           WorkOrder[]                  @relation("WorkOrderDependency")
  signedBy             UserOrganization?            @relation("WorkOrderSignature", fields: [signedById], references: [id])
  vendor               Vendor?                      @relation(fields: [vendorId], references: [id])
  checklistResponses   WorkOrderChecklistResponse[]
  comments             WorkOrderComment[]
  expenses             WorkOrderExpense[]
  files                WorkOrderFile[]
  lotoAudit            WorkOrderLOTO?
  linkedWorkOrders     WorkOrderLink[]              @relation("LinkedWorkOrdersSource")
  linkedFromOrders     WorkOrderLink[]              @relation("LinkedWorkOrdersTarget")
  partsUsed            WorkOrderPart[]
  plannedParts         WorkOrderPlannedPart[]
  statusHistory        WorkOrderStatusHistory[]
  technicians          WorkOrderTechnician[]
  timeLogs             WorkOrderTimeLog[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, categoryId])
  @@index([organizationId, assetId])
  @@index([organizationId, locationId])
  @@index([organizationId, assignedToId])
  @@index([organizationId, assignedTeamId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, completedAt])
  @@index([organizationId, dueDate])
}

model WorkOrderLink {
  id              String    @id @default(uuid())
  sourceId        String
  targetId        String
  linkType        String    @default("RELATED")
  organizationId  String
  createdAt       DateTime  @default(now())
  sourceWorkOrder WorkOrder @relation("LinkedWorkOrdersSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetWorkOrder WorkOrder @relation("LinkedWorkOrdersTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
}

model WorkOrderTechnician {
  workOrderId String
  userId      String
  assignedAt  DateTime         @default(now())
  user        UserOrganization @relation("AssignedWorkOrderTechnicians", fields: [userId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@id([workOrderId, userId])
}

/// Safety Audit Log: Requirements for Lock-Out-Tag-Out procedures
model WorkOrderLOTO {
  id             String            @id @default(uuid())
  workOrderId    String            @unique
  lockVerified   Boolean           @default(false)
  tagVerified    Boolean           @default(false)
  energyVerified Boolean           @default(false)
  lockedById     String?
  lockedAt       DateTime?
  unlockedById   String?
  unlockedAt     DateTime?
  organizationId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  lockedBy       UserOrganization? @relation("WorkOrderLOTOLock", fields: [lockedById], references: [id])
  unlockedBy     UserOrganization? @relation("WorkOrderLOTOUnlock", fields: [unlockedById], references: [id])
  workOrder      WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

model FeatureFlag {
  id             String       @id @default(uuid())
  organizationId String
  key            String
  enabled        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

/// Tracks internal team chat and updates on a work order
model WorkOrderComment {
  id          String           @id @default(uuid())
  workOrderId String
  userId      String
  text        String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        UserOrganization @relation("WorkOrderComments", fields: [userId], references: [id])
  workOrder   WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

/// Tracks exact time spent by multiple technicians with their specific hourly rates
model WorkOrderTimeLog {
  id          String           @id @default(uuid())
  workOrderId String
  userId      String
  category    String?
  hoursLogged Decimal
  hourlyRate  Decimal
  totalCost   Decimal
  startTime   DateTime?
  endTime     DateTime?
  description String?
  createdAt   DateTime         @default(now())
  user        UserOrganization @relation("WorkOrderTimeLogs", fields: [userId], references: [id])
  workOrder   WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

/// Miscellaneous expenses (travel, equipment rental, etc.) for the work order
model WorkOrderExpense {
  id          String            @id @default(uuid())
  workOrderId String
  description String
  category    String
  cost        Decimal
  userId      String?
  date        DateTime          @default(now())
  createdAt   DateTime          @default(now())
  user        UserOrganization? @relation("WorkOrderExpenses", fields: [userId], references: [id])
  workOrder   WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

/// Attachments (before/after photos, manuals) for the work order
model WorkOrderFile {
  id           String    @id @default(uuid())
  workOrderId  String
  filename     String
  url          String
  mimeType     String?
  size         Int?
  uploadedById String
  version      Int       @default(1)
  parentId     String?
  annotations  Json?
  isVoiceNote  Boolean   @default(false)
  duration     Int?
  createdAt    DateTime  @default(now())
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

/// Inventory consumed by this Work Order
model WorkOrderPart {
  id              String            @id @default(uuid())
  workOrderId     String
  partId          String
  inventoryLineId String?
  quantity        Decimal
  unitCost        Decimal
  totalCost       Decimal
  assignedById    String?
  createdAt       DateTime          @default(now())
  assignedBy      UserOrganization? @relation("WorkOrderPartAssignedBy", fields: [assignedById], references: [id])
  inventoryLine   InventoryLine?    @relation(fields: [inventoryLineId], references: [id])
  part            Part              @relation(fields: [partId], references: [id], onDelete: Cascade)
  workOrder       WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

/// Full audit trail of work order states (e.g., OPEN -> IN_PROGRESS) for SLA and response time reports
model WorkOrderStatusHistory {
  id          String           @id @default(uuid())
  workOrderId String
  fromStatus  WorkOrderStatus?
  toStatus    WorkOrderStatus
  changedById String
  reason      String?
  createdAt   DateTime         @default(now())
  workOrder   WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

model Setting {
  id             String       @id @default(uuid())
  key            String
  value          String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([key, organizationId])
}

model Meter {
  id             String            @id @default(uuid())
  name           String
  unit           String
  assetId        String
  currentValue   Decimal?          @default(0)
  threshold      Decimal?
  triggerPM      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  assignedToId   String?
  categoryId     String?
  frequency      Int?              @default(1)
  imageUrl       String?
  locationId     String?
  organizationId String?
  asset          Asset             @relation(fields: [assetId], references: [id])
  assignedTo     UserOrganization? @relation("AssignedMeters", fields: [assignedToId], references: [id])
  category       Category?         @relation(fields: [categoryId], references: [id])
  location       Location?         @relation(fields: [locationId], references: [id])
  organization   Organization?     @relation(fields: [organizationId], references: [id])
  readings       MeterReading[]
  pmSchedules    PMSchedule[]
}

model MeterReading {
  id           String   @id @default(uuid())
  value        Decimal
  meterId      String
  recordedById String?
  notes        String?
  createdAt    DateTime @default(now())
  meter        Meter    @relation(fields: [meterId], references: [id])
}

model Vendor {
  id                 String          @id @default(uuid())
  name               String
  email              String?
  phone              String?
  address            String?
  website            String?
  contactName        String?
  type               String?
  description        String?
  hourlyRate         Decimal?
  isLocationBased    Boolean         @default(false)
  organizationId     String
  deletedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  slaResponseHours   Int?
  slaResolutionHours Int?
  rating             Float?          @default(5.0)
  isPreferred        Boolean         @default(false)
  isFavorite         Boolean         @default(false)
  verificationStatus String          @default("Unverified")
  specialties        String[]        @default([])
  services           String[]        @default([])
  serviceRadius      Int             @default(25)
  licenses           Json?
  insurances         Json?
  certifications     Json?
  assets             Asset[]
  parts              Part[]
  purchaseOrders     PurchaseOrder[]
